[sub_resource type="Shader" id="Shader_campfire_backdrop"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n\nfloat hash(vec2 p) {\n\tp = fract(p * vec2(123.34, 456.21));\n\tp += dot(p, p + 45.32);\n\treturn fract(p.x * p.y);\n}\n\nvoid fragment() {\n\tvec2 uv = UV;\n\tvec3 charcoal = vec3(0.018, 0.024, 0.020);\n\tvec3 smoke = vec3(0.070, 0.043, 0.025);\n\tvec3 ember = vec3(0.48, 0.105, 0.025);\n\tfloat vertical = smoothstep(1.02, 0.05, uv.y);\n\tvec3 color = mix(charcoal, smoke, vertical * 0.42);\n\tvec2 glow_uv = (uv - vec2(0.5, 0.74)) * vec2(1.18, 0.82);\n\tfloat pulse = 0.96 + sin(TIME * 1.7) * 0.04;\n\tfloat glow = exp(-length(glow_uv) * 4.1) * pulse;\n\tcolor = mix(color, ember, glow * 0.82);\n\tfloat upper_haze = exp(-length((uv - vec2(0.5, 0.30)) * vec2(0.78, 1.2)) * 3.0);\n\tcolor += vec3(0.11, 0.035, 0.012) * upper_haze;\n\tfloat vignette = smoothstep(0.92, 0.20, length((uv - vec2(0.5)) * vec2(1.12, 0.88)));\n\tcolor *= 0.48 + vignette * 0.52;\n\tfloat grain = hash(floor(FRAGCOORD.xy / 3.0) + floor(TIME * 3.0)) - 0.5;\n\tcolor += grain * 0.012;\n\tCOLOR = vec4(color, 1.0);\n}"

