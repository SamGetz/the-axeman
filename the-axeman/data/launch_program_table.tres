[gd_resource type="Resource" script_class="LaunchProgramTable" load_steps=14 format=3]

[ext_resource type="Script" path="res://data/launch_program_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/launch_project_def.gd" id="2_project"]
[ext_resource type="Script" path="res://data/spacecraft_component_def.gd" id="3_component"]

[sub_resource type="Resource" id="Project_mission_control"]
script = ExtResource("2_project")
id = &"mission_control"
display_name = "Mission Control"
description = "Build the planning room and specimen communications array beside headquarters."
stage = 0
cash_cost = 400000000
processed_output_required = 100000
mastery_required = 25
contribution_item_id = &"aspen_firewood"
contribution_amount = 200

[sub_resource type="Resource" id="Project_gantry"]
