[resource]
script = ExtResource("1_table")
projects = Array[ExtResource("2_project")]([SubResource("Project_mission_control"), SubResource("Project_gantry"), SubResource("Project_orbital_test"), SubResource("Project_deep_space_vessel")])
components = Array[ExtResource("3_component")]([SubResource("Component_range_survey"), SubResource("Component_range_frontier"), SubResource("Component_cargo_cradle"), SubResource("Component_cargo_hold"), SubResource("Component_shield_basic"), SubResource("Component_shield_deep"), SubResource("Component_resonance_dampener")])
