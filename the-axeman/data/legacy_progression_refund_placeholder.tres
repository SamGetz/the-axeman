[gd_resource type="Resource" script_class="LegacyProgressionRefundTable" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/legacy_progression_refund_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/legacy_capability_seed_def.gd" id="2_seed"]

; Every conversion below is an explicit PLACEHOLDER for v19 migration review.
; XP and recognized skill ranks are overlapping entitlement proofs; migration
; takes the larger explicit conversion and never adds both together.

[sub_resource type="Resource" id="Seed_hold"]
script = ExtResource("2_seed")
legacy_source_id = &"work_rhythm"
target_meta_upgrade_id = &"hold_to_chop"
tuning_status = "PLACEHOLDER — Work Rhythm to Hold-to-Chop migration requires approval"

[sub_resource type="Resource" id="Seed_handoff"]
script = ExtResource("2_seed")
legacy_source_id = &"fast_handoff"
target_meta_upgrade_id = &"continuous_handoff"
tuning_status = "PLACEHOLDER — Fast Handoff to Continuous Handoff migration requires approval"

[sub_resource type="Resource" id="Seed_unbroken"]
script = ExtResource("2_seed")
legacy_source_id = &"unbroken_rhythm"
target_meta_upgrade_id = &"continuous_handoff"
tuning_status = "PLACEHOLDER — Unbroken Rhythm to Continuous Handoff migration requires approval"

[sub_resource type="Resource" id="Seed_delivery"]
script = ExtResource("2_seed")
legacy_source_id = &"fast_delivery"
target_meta_upgrade_id = &"fall_frequency_control"
copy_legacy_rank = true
tuning_status = "PLACEHOLDER — Delivery Control rank migration requires approval"

