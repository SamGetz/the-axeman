[gd_resource type="Resource" script_class="OrderTable" load_steps=29 format=3]

[ext_resource type="Script" path="res://data/order_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/order_def.gd" id="2_def"]

; The original three bonuses are approved exactly as 50 / 150 / 400. Their
; required counts and reveal levels remain the existing candidate tuning.
[sub_resource type="Resource" id="Order_any"]
script = ExtResource("2_def")
id = &"campfire_warmup"
customer_name = "Campsite Manager"
title = "Campfire Warm-up"
description = "A small mixed bundle for tonight's first fires. Any split firewood counts."
required_count = 10
cash_bonus = 50

[sub_resource type="Resource" id="Order_aspen"]
script = ExtResource("2_def")
id = &"aspen_hearth_load"
customer_name = "Neighbour"
title = "Aspen Hearth Load"
description = "A light load of Quaking Aspen for a home hearth."
unlock_level = 2
required_item = &"aspen_firewood"
required_species = &"quaking_aspen"
required_count = 15
cash_bonus = 150

[sub_resource type="Resource" id="Order_pine"]
script = ExtResource("2_def")
id = &"pine_campsite_load"
customer_name = "Campsite Manager"
title = "Pine Campsite Load"
description = "Eastern White Pine for a busy weekend at the campground."
unlock_level = 3
required_item = &"pine_firewood"
required_species = &"eastern_white_pine"
required_count = 20
cash_bonus = 400

; M8 SLICE 6 PLACEHOLDERS. Every later contract uses 20 pieces and a bonus of
; max(400, round_up_to_50(species.unlock_cost * 0.10)). These values are authored
; here, never computed at runtime, and require Sam's measured-tuning review.

[sub_resource type="Resource" id="Order_norway_spruce"]
script = ExtResource("2_def")
id = &"norway_spruce_delivery"
customer_name = "Local Buyer"
title = "Norway Spruce Delivery"
description = "A one-time delivery of Norway Spruce firewood."
unlock_level = 6
required_item = &"norway_spruce_firewood"
required_species = &"norway_spruce"
required_count = 20
cash_bonus = 400
tuning_status = "PLACEHOLDER — post-M8 measured tuning required"

