branch_id = &"strength"
presentation_position = Vector2i(2, 2)
requires = [&"deep_bite", &"wedge_sense"]
effects = Array[ExtResource("3_mod")]([SubResource("Mod_split")])
max_level = 5

[sub_resource type="Resource" id="S05"]
