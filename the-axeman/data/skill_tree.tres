; Strength -----------------------------------------------------------------
[sub_resource type="Resource" id="S01"]
script = ExtResource("2_node")
id = &"strong_arms"
display_name = "Strong Arms"
description = "Each rank adds 2 percentage points to your chance of splitting any wood. At 5/5, that is +10 points."
branch_id = &"strength"
presentation_position = Vector2i(2, 0)
effects = Array[ExtResource("3_mod")]([SubResource("Mod_split")])
max_level = 5

[sub_resource type="Resource" id="S02"]
script = ExtResource("2_node")
id = &"deep_bite"
display_name = "Deep Bite"
description = "Each rank makes every scar add 2 more percentage points to the next split chance. At 5/5, each scar adds 10 extra points."
branch_id = &"strength"
presentation_position = Vector2i(1, 1)
requires = [&"strong_arms"]
effects = Array[ExtResource("3_mod")]([SubResource("Mod_scar")])
max_level = 5

[sub_resource type="Resource" id="S03"]
script = ExtResource("2_node")
