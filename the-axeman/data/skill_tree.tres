; M7C Slice 7 (2026-08-05): Speed's own signature proc. Follow-Up is a bonus
; SWING, not a bonus cut — it re-enters _resolve_strike and can leave a scar
; like any other swing, which is what keeps it mechanically distinct from
; Strength's Double Strike (see chopping_minigame._attempt_follow_up()).
[sub_resource type="Resource" id="Resource_follow_up"]
resource_name = "follow_up"
script = ExtResource("2_node")
id = &"follow_up"
display_name = "Follow-Up"
description = "Your hands are already moving. Sometimes the axe doesn't stop after one swing — a second real swing on whatever's in front of you, split or not."
branch_id = &"speed"
node_type = 1
presentation_position = Vector2i(0, 1)
proc_id = &"follow_up"
requires = [&"quick_hands"]
max_level = 3
cost = 3
effect = 0
effect_step = 0.0

