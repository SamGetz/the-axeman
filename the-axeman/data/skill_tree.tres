presentation_position = Vector2i(1, 3)
requires = [&"hardwood_training"]
effects = Array[ExtResource("3_mod")]([SubResource("Mod_split")])

[sub_resource type="Resource" id="S06"]
script = ExtResource("2_node")
id = &"no_wasted_blow"
display_name = "No Wasted Blow"
description = "Every scar adds 2 more percentage points to the next split chance."
branch_id = &"strength"
node_type = 2
presentation_position = Vector2i(3, 3)
requires = [&"hardwood_training"]
