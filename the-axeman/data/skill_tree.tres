[sub_resource type="Resource" id="S07"]
script = ExtResource("2_node")
id = &"double_strike"
display_name = "Double Chop"
description = "Each successful first cut has a 10% chance to make 1 automatic bonus cut. After 9 misses, the next eligible cut is guaranteed."
branch_id = &"strength"
node_type = 1
presentation_position = Vector2i(2, 4)
proc_id = &"double_strike"
requires = [&"driving_force", &"no_wasted_blow"]
effects = Array[ExtResource("3_mod")]([SubResource("Mod_multi")])

[sub_resource type="Resource" id="S08"]
script = ExtResource("2_node")
id = &"steady_continuation"
display_name = "Steady Continuation"
description = "Double, Triple, and Quad Chop can continue during precision cuts without ruining the protected piece."
branch_id = &"strength"
node_type = 2
presentation_position = Vector2i(1, 5)
requires = [&"double_strike"]
effects = Array[ExtResource("3_mod")]([SubResource("Mod_precision")])

[sub_resource type="Resource" id="S09"]
script = ExtResource("2_node")
id = &"cleaving_judgment"
display_name = "Cleaving Judgment"
description = "Adds 2 percentage points to the split chance of every cut, including automatic bonus cuts."
branch_id = &"strength"
node_type = 2
presentation_position = Vector2i(3, 5)
