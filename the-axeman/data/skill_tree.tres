[gd_resource type="Resource" script_class="SkillTreeTable" load_steps=9 format=3]

[ext_resource type="Script" path="res://data/skill_tree_table.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/skill_node_def.gd" id="2_node"]

[sub_resource type="Resource" id="Resource_strong_arms"]
resource_name = "strong_arms"
script = ExtResource("2_node")
id = &"strong_arms"
display_name = "Strong Arms"
description = "Heavier shoulders behind every blow. 5% more likely to split a log clean through."
branch_id = &"strength"
node_type = 0
presentation_position = Vector2i(0, 0)
requires = []
max_level = 10
cost = 1
effect = 2
effect_step = 0.05

[sub_resource type="Resource" id="Resource_quick_hands"]
resource_name = "quick_hands"
script = ExtResource("2_node")
id = &"quick_hands"
display_name = "Quick Hands"
description = "You get the axe back up 5% sooner between swings."
branch_id = &"speed"
node_type = 0
presentation_position = Vector2i(0, 0)
requires = []
max_level = 10
cost = 1
effect = 1
effect_step = 0.05

[sub_resource type="Resource" id="Resource_ready_stance"]
resource_name = "ready_stance"
script = ExtResource("2_node")
id = &"ready_stance"
display_name = "Ready Stance"
description = "A shorter wind-up. The blade is in the wood before the log knows it."
branch_id = &"speed"
node_type = 0
presentation_position = Vector2i(1, 0)
requires = [&"quick_hands"]
max_level = 5
cost = 2
effect = 3
effect_step = 0.05

[sub_resource type="Resource" id="Resource_quick_study"]
resource_name = "quick_study"
script = ExtResource("2_node")
id = &"quick_study"
display_name = "Quick Study"
description = "Every log teaches you something. Finished logs yield more experience."
branch_id = &"technique"
node_type = 1
presentation_position = Vector2i(0, 0)
proc_id = &"quick_study"
requires = []
max_level = 5
cost = 3
effect = 4
effect_step = 0.05

[resource]
script = ExtResource("1_tree")
nodes = Array[ExtResource("2_node")]([SubResource("Resource_strong_arms"), SubResource("Resource_quick_hands"), SubResource("Resource_ready_stance"), SubResource("Resource_quick_study")])
