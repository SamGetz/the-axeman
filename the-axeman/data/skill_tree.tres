[sub_resource type="Resource" id="S10"]
script = ExtResource("2_node")
id = &"triple_chop"
display_name = "Triple Chop"
description = "When Double Chop triggers, it can make a second automatic bonus cut: up to 3 cuts from one click."
branch_id = &"strength"
node_type = 2
presentation_position = Vector2i(2, 6)
requires = [&"steady_continuation", &"cleaving_judgment"]
effects = Array[ExtResource("3_mod")]([SubResource("Mod_multi")])

[sub_resource type="Resource" id="S11"]
script = ExtResource("2_node")
id = &"earthshaker"
display_name = "Earthshaker"
description = "After a multi-chop chain finishes, every usable piece left on the block receives 1 visible scar."
branch_id = &"strength"
node_type = 3
presentation_position = Vector2i(2, 7)
requires = [&"triple_chop"]
