[gd_resource type="Resource" script_class="SkillTreeTable" load_steps=9 format=3]

[ext_resource type="Script" path="res://data/skill_tree_table.gd" id="1_tree"]
[ext_resource type="Script" path="res://data/skill_node_def.gd" id="2_node"]

[sub_resource type="Resource" id="Resource_strong_arms"]
resource_name = "strong_arms"
script = ExtResource("2_node")
id = &"strong_arms"
display_name = "Strong Arms"
description = "Heavier shoulders behind every blow. 5% more likely to split a log clean through."
requires = []
max_level = 10
cost = 1
effect = 2
effect_step = 0.05

[sub_resource type="Resource" id="Resource_quick_hands"]
resource_name = "quick_hands"
script = ExtResource("2_node")
id = &"quick_hands"
display_name = "Quick Hands"
description = "You get the axe back up 5% sooner between swings."
requires = []
max_level = 10
cost = 1
effect = 1
effect_step = 0.05

[sub_resource type="Resource" id="Resource_keen_edge"]
resource_name = "keen_edge"
script = ExtResource("2_node")
id = &"keen_edge"
display_name = "Keen Edge"
description = "A shorter wind-up. The blade is in the wood before the log knows it."
requires = [&"quick_hands"]
max_level = 5
cost = 2
effect = 3
effect_step = 0.05

[sub_resource type="Resource" id="Resource_splitter"]
resource_name = "splitter"
script = ExtResource("2_node")
id = &"splitter"
display_name = "Splitter"
description = "You read the grain before you swing, and hit where the wood already wants to open."
requires = [&"strong_arms"]
max_level = 5
cost = 2
effect = 2
effect_step = 0.03

[sub_resource type="Resource" id="Resource_woodsman"]
resource_name = "woodsman"
script = ExtResource("2_node")
id = &"woodsman"
display_name = "Woodsman"
description = "Every log teaches you something. Finished logs yield more experience."
requires = [&"keen_edge", &"splitter"]
max_level = 5
cost = 3
effect = 4
effect_step = 0.05

[sub_resource type="Resource" id="Resource_master_axeman"]
resource_name = "master_axeman"
script = ExtResource("2_node")
id = &"master_axeman"
display_name = "Master Axeman"
description = "Your name is worth something at the yard gate. Every piece sells for more."
requires = [&"woodsman"]
max_level = 5
cost = 3
effect = 5
effect_step = 0.05

[resource]
script = ExtResource("1_tree")
nodes = Array[ExtResource("2_node")]([SubResource("Resource_strong_arms"), SubResource("Resource_quick_hands"), SubResource("Resource_keen_edge"), SubResource("Resource_splitter"), SubResource("Resource_woodsman"), SubResource("Resource_master_axeman")])
