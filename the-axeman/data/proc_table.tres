[gd_resource type="Resource" script_class="ProcTable" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/proc_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/proc_def.gd" id="2_proc"]
[ext_resource type="Script" path="res://data/gameplay_modifier_def.gd" id="3_modifier"]

; FINAL SKILL PROC VALUES — approved player-facing balance pass, 2026-08-06.
[sub_resource type="Resource" id="Proc_double_strike"]
script = ExtResource("2_proc")
id = &"double_strike"
display_name = "Double Strike"
family = 0
eligibility = 0
announcement_key = &"double_strike"
presentation_branch_id = &"strength"
base_chance = 0.1
chain_cap = 1
bad_luck_bound = 10
tuning_status = "FINAL — approved skill-tree balance"

; Rolled once per landed ROOT swing (Eligibility.MANUAL_SWING), split or scar —
; unlike Double Strike, Follow-Up does not require a successful cut to fire, so
; it can turn a bounced axe into a second real swing on the same piece. See
; chopping_minigame._attempt_follow_up().
[sub_resource type="Resource" id="Proc_follow_up"]
script = ExtResource("2_proc")
id = &"follow_up"
display_name = "Follow-Up"
family = 1
eligibility = 0
announcement_key = &"follow_up"
presentation_branch_id = &"speed"
base_chance = 0.1
chance_per_rank = 0.0
chain_cap = 1
bad_luck_bound = 10
tuning_status = "FINAL — approved skill-tree balance"

[sub_resource type="Resource" id="Modifier_quick_study_manual_xp"]
script = ExtResource("3_modifier")
id = &"quick_study_manual_xp_multiplier"
kind = 3
operation = 1
magnitude = 2.0
tuning_status = "FINAL — approved skill-tree balance"

; The multiplier is authored data. Quick Study's code never owns this number.
[sub_resource type="Resource" id="Proc_quick_study"]
script = ExtResource("2_proc")
id = &"quick_study"
display_name = "Quick Study"
family = 2
eligibility = 1
announcement_key = &"quick_study"
presentation_branch_id = &"mastery"
base_chance = 0.1
chance_per_rank = 0.0
chain_cap = 1
bad_luck_bound = 10
modifiers = Array[ExtResource("3_modifier")]([SubResource("Modifier_quick_study_manual_xp")])
tuning_status = "FINAL — approved skill-tree balance"

[sub_resource type="Resource" id="Modifier_grain_read_manual_xp"]
script = ExtResource("3_modifier")
id = &"grain_read_xp_multiplier"
kind = 3
operation = 1
magnitude = 12.0
tuning_status = "FINAL — approved skill-tree balance"

; Rolled once per fresh on-block piece (Eligibility.MANUAL_PIECE_OFFER), never per
; swing. base_chance is tuned so that across one whole log's worth of piece-creation
; events (~8: the fresh log plus roughly two per split, and the offer latches off
; after the first hit on a log) roughly one log in six carries a gold mark:
; 1 - (1 - 0.022)^8 =~ 0.16. The multiplier is authored data — code never owns 12.0.
[sub_resource type="Resource" id="Proc_grain_read"]
script = ExtResource("2_proc")
id = &"grain_read"
display_name = "Grain Read"
family = 3
eligibility = 2
announcement_key = &"grain_read"
presentation_branch_id = &"mastery"
base_chance = 0.022
chance_per_rank = 0.0
chain_cap = 1
bad_luck_bound = 60
modifiers = Array[ExtResource("3_modifier")]([SubResource("Modifier_grain_read_manual_xp")])
tuning_status = "FINAL — approved skill-tree balance"

