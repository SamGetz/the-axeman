[resource]
script = ExtResource("1_table")
procs = Array[ExtResource("2_proc")]([SubResource("Proc_double_strike"), SubResource("Proc_follow_up"), SubResource("Proc_quick_study"), SubResource("Proc_grain_read"), SubResource("Proc_mastery_echo"), SubResource("Proc_express_handoff")])
