; GLOBAL TUNING AUTHORITY
; Change values here only after considering the implication comment immediately
; above each setting. PLACEHOLDER values still require measured playtesting;
; APPROVED and FINAL values require Sam's explicit approval before retuning.

[sub_resource type="Resource" id="LevelCurve_main"]
script = ExtResource("2_curve")
; More opening levels extends the softened early-game part of the XP curve and
; delays when the full terrestrial formula takes over.
opening_levels = 9
; Raising this makes the first levels require more XP; lowering it accelerates
; the opening while converging back to the same full curve.
opening_scale = 0.42
; Raising base XP increases every level span and slows the whole campaign;
; lowering it accelerates every progression phase.
base_xp = 26
; Raising the power steepens later terrestrial levels much more than early ones;
; lowering it flattens the campaign and compresses late-level effort.
curve_power = 1.3
; PLACEHOLDER: the repeatable span begins only after the complete terrestrial
; skill-point run and the three representative Frontier levels. Moving it
; changes where infinite progression stops getting progressively slower.
endgame_plateau_level = 112

[sub_resource type="Resource" id="XPPacing_main"]
script = ExtResource("3_xp")
; Acceptance/probe target only: raising this declares a slower desired opening;
; it does not itself alter awarded XP or the level curve.
opening_target_logs_per_level = 1.5
; Acceptance/probe target only: raising this declares a slower terrestrial end;
; it does not itself alter awarded XP or the level curve.
terrestrial_end_target_logs_per_level = 2.5
; PLACEHOLDER fresh-save manual projection band for the 84th core skill point.
; These values define an acceptance target only and require Sam's timed-session
; approval before they can be labelled final.
core_tree_target_min_seconds = 5400.0
core_tree_target_max_seconds = 7200.0
; The final Frontier pacing probe is expected to land near this duration. Change
; it with the alien XP/active-time assumptions or the acceptance gate will move.
final_frontier_target_seconds = 217.0
; This is the assumed hands-on time for an endgame terrestrial log. Raising it
; makes time projections longer without changing live chop speed.
expected_active_seconds_per_endgame_log = 42.0
; Each entry maps a terrestrial species to a representative player level. The
; array must stay aligned one-for-one and in order with SpeciesTable.
representative_terrestrial_levels = PackedInt32Array(1, 3, 6, 9, 13, 17, 21, 25, 29, 33, 37, 41, 45, 49, 53, 57, 61, 65, 69, 73, 77, 81, 86, 91, 96)
; Each entry estimates active seconds for the matching terrestrial species.
; Raising entries lengthens projected campaign time but does not slow gameplay.
representative_terrestrial_active_seconds = PackedFloat32Array(24, 30, 36, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42, 42.5, 43.5, 44.5)
; Each entry maps an alien wood trait to a representative level. The array must
; stay aligned one-for-one and in order with AlienCampaign.traits().
representative_alien_levels = PackedInt32Array(101, 106, 111)
; Each entry estimates active seconds for the matching alien wood. Raising an
; entry lengthens its pacing projection without changing actual cutting speed.
representative_alien_active_seconds = PackedFloat32Array(55, 60, 70)
; Fraction of the current level span paid as a cash reward where cash replaces a
; skill point. Raising it injects more currency and affects the wider economy.
level_cash_load_fraction = 0.2
; PLACEHOLDER campaign compression. This removes the 160-minute terrestrial XP
; wall while per-species manual mastery remains mandatory for all 25 woods.
global_xp_multiplier = 1.55
; Minimum visible orb count for any positive XP award. Raising it makes routine
; rewards busier and increases concurrent presentation work.
orb_minimum_count = 3
; XP amount treated as the logarithmic orb baseline. Raising it delays growth in
; orb count for larger awards; lowering it makes bursts grow sooner.
orb_reference_xp = 120
; Raising the logarithm base slows orb-count growth as XP rises; lowering it
; makes large awards reach the cap sooner.
orb_logarithm_base = 2.0
; Multiplier on logarithmic orb-count growth. Raising it creates more orbs per
; reward tier and reaches the cap earlier.
orb_density = 3.0
; Hard maximum visible orbs in one award. Raising it requires the pool capacity
; to remain at least twice as large and increases worst-case presentation cost.
orb_count_cap = 32
; Prewarmed resident orb count for overlapping batches. Lowering below twice the
; cap violates validation and risks allocations or missing orbs during overlap.
orb_pool_capacity = 64
; Extra scale applied after a capped award can no longer add orbs. Raising it
; makes very large capped awards physically larger on screen.
capped_scale_growth = 0.035
; Extra intensity applied after an award reaches the orb cap. Raising it makes
; huge awards brighter and potentially more visually dominant.
capped_intensity_growth = 0.06
; Delay between filling the XP bar and rolling to the new level. Raising it makes
; cause-and-effect clearer but delays subsequent level presentation.
level_up_bar_hold_seconds = 0.12
; FINAL: bonus XP fraction for Masterwork. Raising it accelerates skilled manual
; progression and changes the approved skill reward balance.
masterwork_xp_bonus = 0.5
; FINAL: cash units granted by Masterwork. Raising it strengthens manual income
; and changes the approved skill/economy balance.
masterwork_cash_units = 2.0

[sub_resource type="Resource" id="Craftsmanship_main"]
script = ExtResource("4_craft")
; Target fraction for one crafted piece. Moving it changes where players must cut
; to earn Clean or Exceptional grades.
target_piece_fraction = 0.25
; Maximum normalized size error for Clean. Raising it makes Clean easier and
; increases average craft bonuses; it must remain at least Exceptional tolerance.
clean_tolerance = 0.1
; Maximum normalized size error for Exceptional. Raising it makes the best grade
; easier and increases high-tier bonus frequency.
exceptional_tolerance = 0.04
; Extra cash fraction for Clean pieces. Raising it increases manual-play income
; without affecting automated output.
clean_cash_bonus = 0.1
; Extra cash fraction for Exceptional pieces. Raising it increases peak manual
; income and it must remain at least the Clean bonus.
exceptional_cash_bonus = 0.25
; Authorship label enforced by validation. Change PLACEHOLDER only when measured
; craftsmanship tuning has actually been reviewed and approved.
tuning_status = "PLACEHOLDER — M7B measured craftsmanship tuning required"

[sub_resource type="Resource" id="GrainCue_main"]
script = ExtResource("5_grain")
; Skill rank required before grain opportunities can appear. Raising it delays
; access; lowering it introduces the mechanic earlier.
minimum_skill_rank = 1
; Positional tolerance used to identify a valid grain cut. Raising it makes the
; assisted cut more forgiving; lowering it demands greater precision.
candidate_tolerance = 0.01
; Fraction of the top surface covered by the mark. Raising it improves visibility
; but reduces the unmarked margin and can visually dominate small pieces.
mark_length_fraction = 0.82
; Width of the bright central line. Raising it makes the exact target clearer but
; makes the precision cue appear less fine.
mark_core_width = 0.01
; Width of the glowing layer. Raising it improves visibility and bloom but can
; obscure the underlying wood grain.
mark_glow_width = 0.024
; Width of the dark contrast backing. Raising it separates the cue from pale wood
; but covers more of the surface; it must remain no smaller than the glow.
mark_dark_width = 0.032
; Height above the wood surface. Too low can cause z-fighting; raising it too far
; makes the mark visibly float.
surface_lift = 0.006
; Separation between mark layers. Too low can flicker; raising it too far splits
; the layered mark when viewed from shallow angles.
layer_lift = 0.0005
; Base cue colour. Changing it affects contrast across every species and the
; established gold visual language for Technique.
mark_color = Color(1.0, 0.78, 0.25, 1.0)
; Seconds per glow cycle. Raising it slows the pulse; lowering it increases motion
; and may become distracting.
glow_pulse_period_sec = 1.6
; Lowest pulse intensity. Raising it keeps the cue continuously brighter; it must
; not exceed the maximum.
glow_pulse_min = 0.35
; Highest pulse intensity. Raising it increases peak bloom and visibility; it
; must remain at least the minimum.
glow_pulse_max = 0.95
; Authorship label enforced by validation. Change PLACEHOLDER only after the
; Technique cue has passed its visual feel-tuning gate.
tuning_status = "PLACEHOLDER — Creative Director tuning required"

[sub_resource type="Resource" id="Splitter_main"]
script = ExtResource("6_splitter")
; APPROVED active-yard seconds per queued log. Raising it lowers watched
; throughput; lowering it raises throughput and alters upgrade pacing.
processing_duration_seconds = 5.0
; APPROVED simultaneous input slots. Raising it changes the one-slot interaction,
; UI, persistence and queue contract—not merely throughput.
queue_capacity = 1
; APPROVED represented logs per baseline split. Raising it increases baseline
; cash and production output, but deliberately does not accelerate XP.
base_logs_per_split = 5
; APPROVED hard cap after Logs per Split upgrades. Raising it increases late-game
; cash/output and changes the signed-off upgrade band, but not XP per minute.
maximum_logs_per_split = 12
; APPROVED firewood units per represented log. Raising it multiplies inventory
; and cash settlement; finished-piece farewell visuals are manual-play only.
output_amount = 1
; APPROVED fraction of equivalent manual XP paid per active second. Raising it
; makes automated levelling compete more strongly with manual play; represented
; log count and cycle speed do not multiply this share.
base_xp_rate = 0.2
; APPROVED floor after Speed upgrades. Lowering it permits faster maximum cycles;
; raising it weakens purchased speed ranks.
minimum_duration_multiplier = 0.5
; Approval label enforced by validation. Do not change this label or any setting
; in this block without a new measured sign-off from Sam.
tuning_status = "APPROVED — Sam 2026-08-05 measured watched-cycle tuning"

[sub_resource type="Resource" id="CompanySimulation_main"]
script = ExtResource("7_company")
; Maximum logs waiting per supplier. Raising it permits longer unattended input
; accumulation; lowering it causes queues to reject work sooner.
supplier_queue_capacity = 24
; Base simulation seconds per log before modifiers. Raising it slows active and
; offline company throughput; lowering it accelerates both.
seconds_per_log = 5.0
; Pieces produced per simulated log. Raising it multiplies company output and
; downstream cash while leaving input consumption unchanged.
output_pieces_per_log = 1
; Maximum offline seconds processed after loading. Raising it increases comeback
; rewards and simulation work; lowering it discards more elapsed production time.
offline_cap_seconds = 14400
; Baseline logs dispatched per simulation cycle before upgrades. Raising it
; increases throughput and drains supplier queues more quickly.
dispatch_capacity = 1
; Maximum retained company return receipts. Raising it preserves more history and
; save data; lowering it removes older entries sooner.
return_ledger_limit = 12
; Authorship label enforced by validation. Change PLACEHOLDER only after active
; and offline logistics have completed measured tuning.
tuning_status = "PLACEHOLDER — M8 logistics/offline measured tuning required"

[sub_resource type="Resource" id="AlienCompany_main"]
script = ExtResource("8_alien")
; Fleet count allowed per alien destination. Raising it increases investment
; capacity and maximum cargo throughput.
fleet_cap_per_destination = 3
; Base seconds per alien cargo cycle before production modifiers. Raising it slows
; interplanetary receipts; lowering it accelerates them.
seconds_per_cargo = 30
; Logs contributed by each fleet per cargo cycle. Raising it increases fleet
; value and can reach the receipt cap sooner.
cargo_logs_per_fleet = 2
; Logs contributed by each orbital line per cycle. Raising it strengthens orbital
; infrastructure and can reach the receipt cap sooner.
orbital_logs_per_line = 3
; Maximum logs represented in one alien automation receipt before multipliers.
; Raising it permits larger bursts; lowering it clips high-investment throughput.
receipt_log_cap = 120
; Authorship label enforced by validation. Change PLACEHOLDER only after measured
; interplanetary throughput review.
tuning_status = "PLACEHOLDER — interplanetary throughput review required"

[sub_resource type="Resource" id="GameFeel_main"]
script = ExtResource("9_feel")
; Real-time length of each hit pause. Raising it makes impacts heavier but stalls
; interaction longer; lowering it makes cuts feel lighter and faster.
hit_pause_duration = 0.06
; Maximum camera offset generated by impact trauma. Raising it makes hits punchier
; but can reduce comfort and visual precision.
camera_shake_amplitude = 0.07
; Trauma removed per second. Raising it makes shake settle faster; lowering it
; lets impacts linger and overlap more strongly.
camera_shake_decay = 6.0
; Upward force applied to ordinary separated log pieces. Raising it makes pieces
; hop higher and changes their landing/readability timing.
log_hop_force = 3.0
; Throw force for perfect-cut feedback. Raising it exaggerates the reward but can
; send fragments farther from the work area.
perfect_cut_throw_force = 7.0
; Piece-size cutoff used by impact presentation. Raising it restricts stronger
; feedback to larger pieces; lowering it lets smaller pieces qualify.
size_threshold = 1

[sub_resource type="Resource" id="RewardBursts_main"]
script = ExtResource("10_rewards")
; PLACEHOLDER: tier arrival points span opening, middle Earth, late Earth and
; alien/jackpot rewards. Review against a continuous fresh campaign before sign-off.
xp_tier_thresholds = PackedInt64Array(1, 120, 1000, 3000)
cash_tier_thresholds = PackedInt64Array(1, 100, 1000, 10000)
denomination_weights = PackedInt32Array(1, 10, 100, 1000)
xp_tier_colors = PackedColorArray(0.55, 1, 0.42, 0.78, 0.3, 0.78, 1, 0.86, 0.76, 0.4, 1, 0.9, 1, 0.9, 0.42, 0.96)
tier_scales = PackedFloat32Array(1, 1.18, 1.38, 1.68)
cash_tokens_per_receipt_cap = 6
tuning_status = "PLACEHOLDER — measured reward feel pass required"

