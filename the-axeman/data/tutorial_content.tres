[sub_resource type="Resource" id="Beat_open_shop"]
script = ExtResource("3_beat")
id = &"open_shop"
guide_id = &"ada"
title = "Open the Shop"
dialogue = "Finishing your first job opened the supplier counter."
objective = "Click the highlighted bag."
completion_kind = 2
completion_value = &"shop_opened"
opening_order = 2
focus_target = &"shop_button"

[sub_resource type="Resource" id="Beat_shop_reading"]
script = ExtResource("3_beat")
id = &"shop_reading"
guide_id = &"ada"
title = "Buy your first upgrade"
dialogue = "Both choices cost 50 coins. Either one makes chopping easier."
objective = "Click either 50-coin button."
completion_kind = 4
opening_order = 3

[sub_resource type="Resource" id="Beat_opening_complete"]
script = ExtResource("3_beat")
id = &"opening_complete"
guide_id = &"rowan"
title = "Your upgrade is already working"
dialogue = "You do not need to equip it."
objective = "Press Got it, then press Back to return to the log."
opening_order = 4
continue_label = "Got it"

[sub_resource type="Resource" id="Beat_open_catalog"]
script = ExtResource("3_beat")
id = &"open_catalog"
guide_id = &"rowan"
title = "A new wood is for sale"
dialogue = "The round log button opens your wood list."
objective = "Click the highlighted log button."
completion_kind = 2
completion_value = &"catalog_opened"
availability_kind = 3
focus_target = &"catalog_button"

[sub_resource type="Resource" id="Beat_catalog_pick"]
script = ExtResource("3_beat")
id = &"catalog_pick"
guide_id = &"rowan"
title = "Buy the new wood"
dialogue = "The coin button beside a wood is its price. Buying it puts that wood on the block next."
objective = "Click the coin price beside the new wood."
completion_kind = 7
availability_kind = 3

[sub_resource type="Resource" id="Beat_open_orders"]
script = ExtResource("3_beat")
id = &"open_orders"
guide_id = &"rowan"
title = "Pick a delivery"
dialogue = "Level 3 opens the job board."
objective = "Click the highlighted clipboard."
completion_kind = 2
completion_value = &"orders_opened"
opening_order = 0
focus_target = &"orders_button"

[sub_resource type="Resource" id="Beat_orders_reading"]
script = ExtResource("3_beat")
id = &"orders_reading"
guide_id = &"rowan"
title = "Finish the first job"
dialogue = "Accept the first job, then cut its pieces. Every piece still gives you coins."
objective = "Accept the job, then deliver 10 pieces."
completion_kind = 9
opening_order = 1

[sub_resource type="Resource" id="Beat_skills"]
script = ExtResource("3_beat")
id = &"skills"
