beats = Array[ExtResource("3_beat")]([SubResource("Beat_skills"), SubResource("Beat_skill_spend"), SubResource("Beat_open_orders"), SubResource("Beat_orders_reading"), SubResource("Beat_open_shop"), SubResource("Beat_shop_reading"), SubResource("Beat_opening_complete"), SubResource("Beat_open_catalog"), SubResource("Beat_catalog_pick"), SubResource("Beat_orders"), SubResource("Beat_automation"), SubResource("Beat_automation_assign"), SubResource("Beat_automation_load"), SubResource("Beat_atlas"), SubResource("Beat_atlas_step"), SubResource("Beat_launch")])
