title = "Follow the yellow goal"
dialogue = "Yellow means next. Grey means finished or not ready yet."
objective = "Find the yellow button, then press Got it."
availability_kind = 6
continue_label = "Got it"

[sub_resource type="Resource" id="Beat_launch"]
script = ExtResource("3_beat")
id = &"launch"
