completion_value = &"catalog_opened"
availability_kind = 5
focus_target = &"splitter_card"

[sub_resource type="Resource" id="Beat_automation_assign"]
script = ExtResource("3_beat")
id = &"automation_assign"
guide_id = &"ada"
title = "Finish the setup"
dialogue = "Find a wood with a Splitter row. Follow its button until it says Assign to splitter."
objective = "Click Assign to splitter."
completion_kind = 8
availability_kind = 5

[sub_resource type="Resource" id="Beat_automation_load"]
script = ExtResource("3_beat")
id = &"automation_load"
guide_id = &"ada"
title = "Start the machine"
dialogue = "It works one log at a time and sells the result for you."
objective = "Click Load assigned log on the machine card."
completion_kind = 2
completion_value = &"splitter_loaded"
availability_kind = 5
focus_target = &"splitter_card"

[sub_resource type="Resource" id="Beat_atlas"]
script = ExtResource("3_beat")
id = &"atlas"
