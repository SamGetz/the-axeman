title = "You earned a skill point"
dialogue = "The axe button glows when a point is ready."
objective = "Click the highlighted axe."
completion_kind = 2
completion_value = &"skills_opened"
availability_kind = 1
focus_target = &"skills_button"

[sub_resource type="Resource" id="Beat_skill_spend"]
script = ExtResource("3_beat")
id = &"skill_spend"
guide_id = &"ada"
title = "Choose a skill"
dialogue = "Grey squares show the full path. Fill every prerequisite rank to unlock the next skill."
objective = "Click any coloured square."
completion_kind = 6
availability_kind = 1

[sub_resource type="Resource" id="Beat_orders"]
script = ExtResource("3_beat")
id = &"orders"
guide_id = &"rowan"
title = "More deliveries are ready"
dialogue = "The board now keeps three repeat jobs ready for you."
objective = "Click the clipboard when you want another job."
completion_kind = 2
completion_value = &"orders_opened"
availability_kind = 4
focus_target = &"orders_button"

[sub_resource type="Resource" id="Beat_automation"]
script = ExtResource("3_beat")
id = &"automation"
guide_id = &"ada"
title = "Give the splitter a wood"
dialogue = "The machine can cut logs while you keep playing. It needs a wood before it can start."
objective = "Click Assign in Tree Catalog on the machine card."
