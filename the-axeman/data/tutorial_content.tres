dialogue = "The map shows where your next wood comes from."
objective = "Click the highlighted map button."
completion_kind = 2
completion_value = &"atlas_opened"
availability_kind = 6
focus_target = &"atlas_button"

[sub_resource type="Resource" id="Beat_atlas_step"]
script = ExtResource("3_beat")
id = &"atlas_step"
