[sub_resource type="Resource" id="Upgrade_axe_power"]
script = ExtResource("2_def")
id = &"axe_power"
display_name = "Axe Power"
description = "Improves split reliability; rank milestones advance the existing axe presentation."
limitation = "It does not remove species, level, or boss hardness."
icon_path = "res://assets/ui/reward_note_bundle.svg"
max_rank = 8
costs_by_rank = PackedInt64Array(50, 100, 200, 400, 800, 1600, 3200, 6400)
