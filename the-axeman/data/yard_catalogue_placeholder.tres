[gd_resource type="Resource" script_class="YardTable" load_steps=4 format=3]

[ext_resource type="Script" path="res://data/yard_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/yard_def.gd" id="2_yard_def"]
[ext_resource type="Resource" path="res://data/yards/yard_one_placeholder.tres" id="3_yard_one"]

; This file is only the selectable-level catalogue. Each level owns a standalone
; YardDef resource under res://data/yards/ so its complete tuning is editable in
; one Inspector surface without expanding a large inline table subresource.

[resource]
script = ExtResource("1_table")
yards = Array[ExtResource("2_yard_def")]([ExtResource("3_yard_one")])
