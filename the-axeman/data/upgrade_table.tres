[gd_resource type="Resource" script_class="UpgradeTable" load_steps=17 format=3]

[ext_resource type="Script" path="res://data/upgrade_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/upgrade_def.gd" id="2_def"]

; CANDIDATE TUNING PROFILE ONLY — roles/order are approved; Sam has not signed
; off these prices or effect magnitudes. The measured M7A session replaces them.
[sub_resource type="Resource" id="Upgrade_balanced_axe"]
script = ExtResource("2_def")
id = &"balanced_axe"
display_name = "Balanced Axe"
description = "A steadier general-purpose axe that makes ordinary splits a little more reliable."
limitation = "Does not speed the swing, improve payouts, or unlock skill procs. A split is never guaranteed."
purchase_form = 0
base_cost = 50
cost_growth = 1.0
max_level = 1
effect = 1
effect_step = 0.03

[sub_resource type="Resource" id="Upgrade_reinforced_block"]
script = ExtResource("2_def")
id = &"reinforced_chopping_block"
display_name = "Reinforced Chopping Block"
description = "The first rank adds a broader, steadier work surface that keeps useful billets readable."
limitation = "Does not change split odds, cut classification, XP, cash, or physics capacity."
purchase_form = 1
base_cost = 50
cost_growth = 1.0
max_level = 1
effect = 2
effect_step = 0.15

[sub_resource type="Resource" id="Upgrade_supplier_ledger"]
script = ExtResource("2_def")
id = &"supplier_ledger"
display_name = "Supplier Ledger"
description = "Opens the first supplier relationship and makes the next species eligible to purchase."
limitation = "The wood is not included: its level gate, separate price, delivery, and manual lesson still apply."
purchase_form = 0
unlock_order_id = &"campfire_warmup"
base_cost = 150
cost_growth = 1.0
max_level = 1

[sub_resource type="Resource" id="Upgrade_handcart"]
script = ExtResource("2_def")
id = &"handcart"
display_name = "Handcart"
description = "Stages one selected log while the current load settles, shortening non-interactive delivery time."
limitation = "Does not chop, queue multiple logs, change the 50-piece pile, or increase payout."
purchase_form = 0
unlock_after_haul_aways = 1
base_cost = 150
cost_growth = 1.0
max_level = 1
effect = 3
effect_step = 0.5

[sub_resource type="Resource" id="Upgrade_coffee_thermos"]
script = ExtResource("2_def")
id = &"coffee_thermos"
display_name = "Coffee Thermos"
description = "Permanent yard equipment that modestly shortens ordinary recovery between manual swings."
limitation = "Not a consumable. Does not refund swings, create follow-ups or streaks, or change wind-up and split odds."
purchase_form = 0
unlock_order_id = &"aspen_hearth_load"
base_cost = 400
cost_growth = 1.0
max_level = 1
effect = 4
effect_step = 0.05

; M8 APPROVED SYSTEM-BUILDING TUNING. Sam signed off this certification gate,
; the machine/profile prices and all five progression lines on 2026-08-05.
[sub_resource type="Resource" id="Upgrade_mechanical_splitter"]
script = ExtResource("2_def")
id = &"mechanical_splitter"
display_name = "Mechanical Splitter"
description = "Authorises the yard's first splitter installation, ready for separately purchased certified-wood profiles."
limitation = "Requires separately purchased certified profiles. Runs only while the yard is active and never grants mastery, certification or manual skill procs."
purchase_form = 0
required_upgrade_id = &"coffee_thermos"
required_mastered_species_count = 3
base_cost = 1000
cost_growth = 1.0
max_level = 1
automation_role = 1
tuning_status = "APPROVED — Sam 2026-08-05: 1,000 cash and 3 certifications"

[sub_resource type="Resource" id="Upgrade_splitter_profile_aspen"]
script = ExtResource("2_def")
id = &"splitter_profile_quaking_aspen"
display_name = "Splitter Profile · Quaking Aspen"
description = "Installs the certified Quaking Aspen cutting profile in the Mechanical Splitter."
limitation = "Does not certify Aspen, run the machine, improve hand chopping, or admit any other species."
purchase_form = 0
required_upgrade_id = &"mechanical_splitter"
required_mastery_species_id = &"quaking_aspen"
base_cost = 250
cost_growth = 1.0
max_level = 1
automation_role = 2
automation_species_id = &"quaking_aspen"
tuning_status = "APPROVED — Sam 2026-08-05: 250 cash per certified profile"

; M8 APPROVED SPLITTER PROGRESSION. Each line reveals after the previous line
; has at least one purchased rank.
[sub_resource type="Resource" id="Upgrade_splitter_speed"]
script = ExtResource("2_def")
id = &"splitter_speed"
display_name = "Splitter Speed"
description = "Shortens each watched Mechanical Splitter cycle."
limitation = "Does not speed manual swings, add logs, change XP, or increase sale value."
purchase_form = 1
required_upgrade_id = &"mechanical_splitter"
base_cost = 500
cost_growth = 1.5
max_level = 5
effect = 5
effect_step = 0.1
automation_role = 3
tuning_status = "APPROVED — Sam 2026-08-05: 500 base, x1.5, 5 ranks, -10% per rank"

[sub_resource type="Resource" id="Upgrade_splitter_auto_load"]
script = ExtResource("2_def")
id = &"splitter_auto_load"
display_name = "Splitter Auto Loading"
description = "Loads the assigned certified log whenever the one input slot is empty."
limitation = "Watched yard time only. Does not add queue capacity, delivery simulation, or offline progress."
purchase_form = 0
required_upgrade_id = &"splitter_speed"
base_cost = 2500
cost_growth = 1.0
max_level = 1
effect = 6
effect_step = 1.0
automation_role = 3
tuning_status = "APPROVED — Sam 2026-08-05: 2,500 one-time"

[sub_resource type="Resource" id="Upgrade_splitter_logs_per_split"]
script = ExtResource("2_def")
id = &"splitter_logs_per_split"
display_name = "Logs per Split"
description = "Processes one additional assigned log in each represented splitter batch."
limitation = "The machine still shows one representative log and keeps one bounded input slot."
purchase_form = 1
required_upgrade_id = &"splitter_auto_load"
base_cost = 1000
cost_growth = 1.4
max_level = 7
effect = 7
effect_step = 1.0
automation_role = 3
tuning_status = "APPROVED — Sam 2026-08-05: 1,000 base, x1.4, 7 ranks, +1 from 5 to 12"

[sub_resource type="Resource" id="Upgrade_splitter_xp_gain"]
script = ExtResource("2_def")
id = &"splitter_xp_gain"
display_name = "Splitter Experience Gain"
description = "Raises automation XP above its approved starting 20% species rate."
limitation = "Does not grant mastery, certification, manual skill procs, or manual XP bonuses."
