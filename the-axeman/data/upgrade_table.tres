[ext_resource type="Script" path="res://data/upgrade_def.gd" id="2_def"]
[ext_resource type="Script" path="res://data/production_upgrade_def.gd" id="3_prod"]

; CANDIDATE TUNING PROFILE ONLY — roles/order are approved; Sam has not signed
; off these prices or effect magnitudes. The measured M7A session replaces them.
[sub_resource type="Resource" id="Upgrade_balanced_axe"]
script = ExtResource("2_def")
id = &"balanced_axe"
display_name = "Balanced Axe"
description = "Adds 3% to your chance of splitting any wood."
limitation = "Swing speed and payouts are unchanged."
purchase_form = 0
base_cost = 50
cost_growth = 1.0
max_level = 1
effect = 1
effect_step = 0.03

[sub_resource type="Resource" id="Upgrade_reinforced_block"]
script = ExtResource("2_def")
id = &"reinforced_chopping_block"
display_name = "Reinforced Chopping Block"
description = "Widens the usable chopping area by 15%, making pieces easier to finish."
limitation = "Split chance, XP, and cash are unchanged."
purchase_form = 1
base_cost = 50
cost_growth = 1.0
max_level = 1
effect = 2
effect_step = 0.15

[sub_resource type="Resource" id="Upgrade_supplier_ledger"]
script = ExtResource("2_def")
id = &"supplier_ledger"
display_name = "Supplier Ledger"
description = "Opens your first supplier so you can buy Eastern White Pine."
limitation = "The wood is purchased separately in the Tree Catalog."
purchase_form = 0
unlock_order_id = &"campfire_warmup"
base_cost = 150
cost_growth = 1.0
max_level = 1

[sub_resource type="Resource" id="Upgrade_handcart"]
script = ExtResource("2_def")
id = &"handcart"
display_name = "Handcart"
description = "Brings the next selected log to the block 50% sooner."
limitation = "Does not chop logs or increase their value."
purchase_form = 0
unlock_after_haul_aways = 1
base_cost = 150
cost_growth = 1.0
max_level = 1
effect = 3
effect_step = 0.5

[sub_resource type="Resource" id="Upgrade_coffee_thermos"]
script = ExtResource("2_def")
id = &"coffee_thermos"
display_name = "Coffee Thermos"
description = "Permanently shortens the wait after every hand swing by 5%."
limitation = "Axe wind-up and split chance are unchanged."
purchase_form = 0
unlock_order_id = &"aspen_hearth_load"
base_cost = 400
cost_growth = 1.0
max_level = 1
effect = 4
effect_step = 0.05

; M8 APPROVED SYSTEM-BUILDING TUNING. Sam signed off this certification gate,
; the machine/profile prices and all five progression lines on 2026-08-05.
[sub_resource type="Resource" id="Upgrade_mechanical_splitter"]
script = ExtResource("2_def")
id = &"mechanical_splitter"
display_name = "Mechanical Splitter"
description = "Installs a machine that cuts and sells mastered woods while the yard is open."
limitation = "Each wood needs its own setup. Automatic cutting does not earn mastery."
purchase_form = 0
required_upgrade_id = &"coffee_thermos"
required_mastered_species_count = 3
base_cost = 1000
cost_growth = 1.0
max_level = 1
automation_role = 1
tuning_status = "APPROVED — Sam 2026-08-05: 1,000 cash and 3 certifications"

[sub_resource type="Resource" id="Upgrade_splitter_profile_aspen"]
script = ExtResource("2_def")
id = &"splitter_profile_quaking_aspen"
display_name = "Splitter Setup · Quaking Aspen"
description = "Lets the Mechanical Splitter cut Quaking Aspen."
limitation = "Works only with Quaking Aspen, which must be mastered first."
purchase_form = 0
required_upgrade_id = &"mechanical_splitter"
required_mastery_species_id = &"quaking_aspen"
base_cost = 250
cost_growth = 1.0
max_level = 1
automation_role = 2
automation_species_id = &"quaking_aspen"
tuning_status = "APPROVED — Sam 2026-08-05: 250 cash per certified profile"

; M8 APPROVED SPLITTER PROGRESSION. Each line reveals after the previous line
; has at least one purchased rank.
[sub_resource type="Resource" id="Upgrade_splitter_speed"]
script = ExtResource("2_def")
id = &"splitter_speed"
display_name = "Splitter Speed"
description = "Each rank makes the Mechanical Splitter finish its work 10% sooner."
limitation = "Hand swings, logs per batch, XP, and sale value are unchanged."
purchase_form = 1
required_upgrade_id = &"mechanical_splitter"
base_cost = 500
cost_growth = 1.5
max_level = 5
effect = 5
effect_step = 0.1
automation_role = 3
tuning_status = "APPROVED — Sam 2026-08-05: 500 base, x1.5, 5 ranks, -10% per rank"

[sub_resource type="Resource" id="Upgrade_splitter_auto_load"]
script = ExtResource("2_def")
id = &"splitter_auto_load"
display_name = "Splitter Auto Loading"
