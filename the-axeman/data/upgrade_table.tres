script = ExtResource("1_table")
upgrades = Array[ExtResource("2_def")]([SubResource("Upgrade_balanced_axe"), SubResource("Upgrade_reinforced_block"), SubResource("Upgrade_supplier_ledger"), SubResource("Upgrade_handcart"), SubResource("Upgrade_coffee_thermos"), SubResource("Upgrade_mechanical_splitter"), SubResource("Upgrade_splitter_profile_aspen"), SubResource("Upgrade_splitter_profile_pine"), SubResource("Upgrade_splitter_profile_spruce"), SubResource("Upgrade_splitter_speed"), SubResource("Upgrade_splitter_auto_load"), SubResource("Upgrade_splitter_logs_per_split"), SubResource("Upgrade_splitter_xp_gain"), SubResource("Upgrade_splitter_cash_gain")])
