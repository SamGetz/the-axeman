[gd_resource type="Resource" script_class="SpeciesMasteryTable" load_steps=43 format=3]

[ext_resource type="Script" path="res://data/species_mastery_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/species_mastery_def.gd" id="2_mastery"]
[ext_resource type="Script" path="res://data/certification_requirement_def.gd" id="3_requirement"]
[ext_resource type="Script" path="res://data/species_mastery_threshold_def.gd" id="4_threshold"]
[ext_resource type="Script" path="res://data/gameplay_modifier_def.gd" id="5_modifier"]

; M8 SLICE 1 SYSTEM-BUILDING PLACEHOLDERS ONLY. Sam's measured tuning gate owns
; the shared progress thresholds and all nine reward magnitudes below.
[sub_resource type="Resource" id="Reward_t1_cash"]
script = ExtResource("5_modifier")
id = &"mastery_t1_cash"
kind = 8
magnitude = 0.001
tuning_status = "PLACEHOLDER — M8 measured tuning required"

[sub_resource type="Resource" id="Reward_t1_xp"]
script = ExtResource("5_modifier")
id = &"mastery_t1_xp"
kind = 3
magnitude = 0.001
tuning_status = "PLACEHOLDER — M8 measured tuning required"

[sub_resource type="Resource" id="Reward_t1_split"]
script = ExtResource("5_modifier")
id = &"mastery_t1_split"
kind = 0
magnitude = 0.0005
tuning_status = "PLACEHOLDER — M8 measured tuning required"

[sub_resource type="Resource" id="Threshold_1"]
script = ExtResource("4_threshold")
required_progress = 1
rewards = Array[ExtResource("5_modifier")]([SubResource("Reward_t1_cash"), SubResource("Reward_t1_xp"), SubResource("Reward_t1_split")])
tuning_status = "PLACEHOLDER — M8 measured tuning required"

