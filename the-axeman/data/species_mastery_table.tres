[ext_resource type="Script" path="res://data/certification_requirement_def.gd" id="3_requirement"]

; SHARED SYSTEM-BUILDING PLACEHOLDERS ONLY. Slice 8 and Sam's tuning gate own
; species-specific targets, awards, reveal thresholds and checklist counts.
[sub_resource type="Resource" id="Requirement_manual"]
script = ExtResource("3_requirement")
kind = 0
required_count = 1
label = "Complete the authored number of logs manually"

[sub_resource type="Resource" id="Mastery_quaking_aspen"]
script = ExtResource("2_mastery")
species_id = &"quaking_aspen"
reveal_thresholds = PackedInt32Array(1, 5, 10)
certification_requirements = Array[ExtResource("3_requirement")]([SubResource("Requirement_manual")])

