[gd_resource type="Resource" script_class="CompanyDoctrineTable" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/company_doctrine_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/company_doctrine_def.gd" id="2_def"]

[sub_resource type="Resource" id="Doctrine_craft"]
script = ExtResource("2_def")
id = &"craft_house"
display_name = "Craft House"
description = "Clean and exceptional hand-cut pieces sell for 10% more."
effect = 0
magnitude = 0.1

[sub_resource type="Resource" id="Doctrine_logistics"]
script = ExtResource("2_def")
id = &"logistics_company"
display_name = "Logistics Company"
description = "Processes one more supplier at a time."
effect = 1
magnitude = 1.0

[sub_resource type="Resource" id="Doctrine_specialist"]
script = ExtResource("2_def")
id = &"global_specialist"
display_name = "Global Specialist"
description = "Regional customer jobs give +1 standing."
effect = 2
magnitude = 1.0

[resource]
script = ExtResource("1_table")
doctrines = Array[ExtResource("2_def")]([SubResource("Doctrine_craft"), SubResource("Doctrine_logistics"), SubResource("Doctrine_specialist")])
