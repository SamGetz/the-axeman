[resource]
script = ExtResource("1_table")
regions = Array[ExtResource("2_region")]([SubResource("Region_east"), SubResource("Region_boreal"), SubResource("Region_north_europe"), SubResource("Region_pacific_northwest"), SubResource("Region_western_europe"), SubResource("Region_australia"), SubResource("Region_specialist")])
routes = Array[ExtResource("3_route")]([SubResource("Route_east"), SubResource("Route_boreal"), SubResource("Route_europe"), SubResource("Route_pacific"), SubResource("Route_western_europe"), SubResource("Route_australia"), SubResource("Route_specialist")])
projects = Array[ExtResource("4_project")]([SubResource("Project_east"), SubResource("Project_rail"), SubResource("Project_port"), SubResource("Project_headquarters"), SubResource("Project_world_archive"), SubResource("Project_freight_grid"), SubResource("Project_buyer_exchange")])
