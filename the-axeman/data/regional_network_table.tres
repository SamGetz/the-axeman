[gd_resource type="Resource" script_class="RegionalNetworkTable" load_steps=26 format=3]

[ext_resource type="Script" path="res://data/regional_network_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/region_def.gd" id="2_region"]
[ext_resource type="Script" path="res://data/route_def.gd" id="3_route"]
[ext_resource type="Script" path="res://data/infrastructure_project_def.gd" id="4_project"]

[sub_resource type="Resource" id="Region_east"]
script = ExtResource("2_region")
id = &"eastern_north_america"
display_name = "Eastern North America"
description = "Home-region hardwood and hearthwood suppliers connected to the yard's first customer network."
species_ids = Array[StringName]([&"quaking_aspen", &"eastern_white_pine", &"paper_birch", &"black_ash", &"northern_red_oak", &"american_beech", &"white_ash", &"white_oak", &"sugar_maple"])
customer_ids = Array[StringName]([&"hearth_circle", &"village_baker"])
depot_standing_required = 2
depot_cost = 25000

[sub_resource type="Resource" id="Region_boreal"]
script = ExtResource("2_region")
id = &"boreal_north_america"
display_name = "Boreal North America"
description = "Long conifer corridors where dependable standing opens a cold-weather depot."
species_ids = Array[StringName]([&"balsam_fir", &"lodgepole_pine", &"white_spruce", &"black_spruce", &"red_pine"])
customer_ids = Array[StringName]([&"smokehouse_keeper", &"regional_wholesaler"])
reputation_required = 4
depot_standing_required = 3
depot_cost = 90000

[sub_resource type="Resource" id="Region_north_europe"]
script = ExtResource("2_region")
id = &"northern_europe"
display_name = "Northern Europe"
