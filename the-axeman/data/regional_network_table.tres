species_ids = Array[StringName]([&"norway_spruce", &"silver_birch", &"yellow_birch"])
customer_ids = Array[StringName]([&"joiners_workshop", &"hill_cooperative"])
reputation_required = 8
depot_standing_required = 4
depot_cost = 260000

