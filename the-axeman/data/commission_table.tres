[gd_resource type="Resource" script_class="CommissionTable" load_steps=16 format=3]

[ext_resource type="Script" path="res://data/commission_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/commission_template_def.gd" id="2_template"]
[ext_resource type="Script" path="res://data/craft_requirement_def.gd" id="3_requirement"]

[sub_resource type="Resource" id="Requirement_quantity"]
script = ExtResource("3_requirement")
family = 0

[sub_resource type="Resource" id="Requirement_species"]
script = ExtResource("3_requirement")
family = 1

[sub_resource type="Resource" id="Requirement_size"]
script = ExtResource("3_requirement")
family = 2
min_normalized_size = 0.18
max_normalized_size = 0.34

[sub_resource type="Resource" id="Requirement_quality"]
script = ExtResource("3_requirement")
family = 3
minimum_grade = 1

[sub_resource type="Resource" id="Requirement_signature"]
script = ExtResource("3_requirement")
family = 4
minimum_grade = 2
require_source_identity = true

; FOUR-HOUR CAMPAIGN PLACEHOLDERS. These are intentionally long background goals.
; Every quantity and premium still requires measured campaign pacing approval.

[sub_resource type="Resource" id="Commission_neighbourhood_bundle"]
script = ExtResource("2_template")
id = &"neighbourhood_bundle"
customer_id = &"hearth_circle"
customer_name = "Neighbourhood Hearth Circle"
title_format = "Mixed Firewood Round"
description = "A forgiving mixed load for several nearby hearths. Any split firewood counts."
goal_kind = 0
effort_band = 0
required_count = 60
premium_ratio = 0.3
craft_requirement = SubResource("Requirement_quantity")
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[sub_resource type="Resource" id="Commission_evening_fires"]
script = ExtResource("2_template")
id = &"evening_fires"
customer_id = &"hearth_circle"
customer_name = "Neighbourhood Hearth Circle"
title_format = "Mixed Evening Fires"
description = "Several homes are sharing one evening delivery; any split firewood can finish the round."
goal_kind = 0
effort_band = 1
required_count = 90
premium_ratio = 0.32
craft_requirement = SubResource("Requirement_quantity")
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[sub_resource type="Resource" id="Commission_bakery_kindling"]
script = ExtResource("2_template")
id = &"bakery_kindling"
customer_id = &"village_baker"
customer_name = "Village Baker"
title_format = "{species} Oven Stack"
description = "A compact, dry stack for tomorrow's first bread firing."
goal_kind = 1
effort_band = 0
required_count = 70
premium_ratio = 0.35
craft_requirement = SubResource("Requirement_species")
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[sub_resource type="Resource" id="Commission_smokehouse_stack"]
script = ExtResource("2_template")
id = &"smokehouse_stack"
customer_id = &"smokehouse_keeper"
customer_name = "Smokehouse Keeper"
title_format = "{species} Smokehouse Stack"
description = "A steady species-matched load for a long, even smokehouse firing."
goal_kind = 1
effort_band = 1
required_count = 100
premium_ratio = 0.35
reputation_required = 4
craft_requirement = SubResource("Requirement_size")
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[sub_resource type="Resource" id="Commission_wholesale_bulk"]
script = ExtResource("2_template")
id = &"wholesale_bulk"
customer_id = &"regional_wholesaler"
customer_name = "Regional Wood Buyer"
title_format = "{species} Trade Load"
description = "A bulk load of one mastered wood; hand-cut or machine-cut pieces both count."
goal_kind = 1
effort_band = 2
required_count = 160
premium_ratio = 0.3
reputation_required = 6
craft_requirement = SubResource("Requirement_species")
automation_eligible_bulk = true
tuning_status = "PLACEHOLDER — M8/M9 bulk fulfilment review required"

[sub_resource type="Resource" id="Commission_workshop_drywood"]
script = ExtResource("2_template")
id = &"workshop_drywood"
customer_id = &"joiners_workshop"
customer_name = "Joiner's Workshop"
title_format = "{species} Workshop Reserve"
description = "A carefully counted reserve for the joinery shop's drying stove."
goal_kind = 1
effort_band = 2
required_count = 120
premium_ratio = 0.4
reputation_required = 8
craft_requirement = SubResource("Requirement_quality")
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[sub_resource type="Resource" id="Commission_winter_reserve"]
script = ExtResource("2_template")
id = &"winter_reserve"
customer_id = &"hill_cooperative"
customer_name = "Hill Cottage Cooperative"
title_format = "{species} Winter Reserve"
description = "A substantial winter reserve shared between the exposed hill cottages."
goal_kind = 1
effort_band = 2
required_count = 150
premium_ratio = 0.4
reputation_required = 14
craft_requirement = SubResource("Requirement_signature")
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[resource]
script = ExtResource("1_table")
relevance_premium_ratio = 0.3
campaign_offer_limit = 5
target_duration_min_seconds = 1500.0
target_duration_max_seconds = 2400.0
tuning_status = "PLACEHOLDER — four-hour campaign playtest required"
templates = Array[ExtResource("2_template")]([SubResource("Commission_neighbourhood_bundle"), SubResource("Commission_evening_fires"), SubResource("Commission_bakery_kindling"), SubResource("Commission_smokehouse_stack"), SubResource("Commission_wholesale_bulk"), SubResource("Commission_workshop_drywood"), SubResource("Commission_winter_reserve")])
