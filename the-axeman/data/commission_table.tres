[gd_resource type="Resource" script_class="CommissionTable" load_steps=9 format=3]

[ext_resource type="Script" path="res://data/commission_table.gd" id="1_table"]
[ext_resource type="Script" path="res://data/commission_template_def.gd" id="2_template"]

; M9 SYSTEM-BUILDING PLACEHOLDERS. Customer identities and the mixed/specific
; offer structure are reviewable content; every quantity and premium ratio still
; requires Sam's measured early/middle/late pacing approval.

[sub_resource type="Resource" id="Commission_neighbourhood_bundle"]
script = ExtResource("2_template")
id = &"neighbourhood_bundle"
customer_name = "Neighbourhood Hearth Circle"
title_format = "Mixed Firewood Round"
description = "A forgiving mixed load for several nearby hearths. Any split firewood counts."
goal_kind = 0
required_count = 12
premium_ratio = 0.2
tuning_status = "PLACEHOLDER — M9 measured tuning required"

[sub_resource type="Resource" id="Commission_evening_fires"]
script = ExtResource("2_template")
id = &"evening_fires"
customer_name = "Evening Fire Steward"
title_format = "Mixed Evening Fires"
description = "A flexible standing order for tonight's fires. Any split firewood counts."
goal_kind = 0
required_count = 18
premium_ratio = 0.22
tuning_status = "PLACEHOLDER — M9 measured tuning required"

