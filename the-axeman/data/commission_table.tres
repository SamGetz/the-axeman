[resource]
script = ExtResource("1_table")
templates = Array[ExtResource("2_template")]([SubResource("Commission_neighbourhood_bundle"), SubResource("Commission_evening_fires"), SubResource("Commission_bakery_kindling"), SubResource("Commission_smokehouse_stack"), SubResource("Commission_workshop_drywood"), SubResource("Commission_winter_reserve")])
